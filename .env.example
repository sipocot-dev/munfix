# --- Services (match docker-compose.yml) ---
DATABASE_URL=postgres://munfix:munfix@localhost:5432/munfix
REDIS_URL=redis://localhost:6379

# --- App ---
# Public URL of the app. Session cookies are marked Secure when this is https.
APP_URL=http://localhost:3000

# --- Startup ---
# On boot the app applies pending migrations and seeds categories and the admin account
# (SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD below). Set to "false" to run `npm run db:migrate` yourself.
# AUTO_SETUP=true

# --- Photo storage ---
# "local" (default) writes to UPLOAD_DIR; "s3" uses any S3-compatible service
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2). Use s3 when running more than one instance.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3_BUCKET=munfix-photos
# S3_REGION=auto                  # "auto" for Cloudflare R2, e.g. ap-southeast-1 for AWS
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false       # true for MinIO
# S3_PREFIX=                      # optional key prefix inside the bucket

# --- Email notifications (optional) ---
# Reporters get an email when their report is received and when it is verified, started,
# resolved, rejected or merged as a duplicate. Leave unset to disable email entirely.
# Use either SMTP_URL (smtps://user:pass@smtp.example.com:465) or the separate fields below.
# Test your settings with: npm run mail:test -- you@example.com
# SMTP_URL=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false               # defaults to true on port 465
# SMTP_USER=
# SMTP_PASS=                      # SMTP_PASSWORD works too
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character app password>, SMTP_FROM="Better Sipocot <you@gmail.com>"
# MAIL_FROM="MunFix Sipocot <no-reply@yourdomain.ph>"

# --- Social sign-in (optional) ---
# A provider's button appears on the login page only when both its ID and secret are set.
# Redirect URI to register with each provider: <APP_URL>/api/v1/auth/oauth/<google|facebook>/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET / AUTH_FACEBOOK_ID / AUTH_FACEBOOK_SECRET are accepted as aliases.

# --- Municipality (inlined at build time) ---
NEXT_PUBLIC_MUNICIPALITY_NAME=Sipocot
NEXT_PUBLIC_PROVINCE_NAME=Camarines Sur
# Map center, longitude/latitude
NEXT_PUBLIC_MAP_CENTER_LNG=122.9833
NEXT_PUBLIC_MAP_CENTER_LAT=13.7667
# Reports must be pinned inside this box: minLng,minLat,maxLng,maxLat
NEXT_PUBLIC_MAP_BOUNDS=122.70,13.50,123.25,14.05
# Raster tile template. The public OSM server is fine for development only;
# use a tile provider or your own tile server in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Seeding (npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@munfix.local
# In production this must be 12+ characters and not a common password, or no admin is created.
# Alternatively leave it and run: npm run admin:create -- --email you@example.com
SEED_ADMIN_PASSWORD=change-me-please
# Set to true to also insert a handful of demo reports
SEED_DEMO=false
# Create demo citizen/moderator/staff logins on startup (password: DEMO_PASSWORD, default demo-password).
# Fine for a pilot; deactivate them on Admin -> Users before real use.
SEED_DEMO_ACCOUNTS=false
# DEMO_PASSWORD=
