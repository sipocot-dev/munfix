# --- Services (match docker-compose.yml) ---
DATABASE_URL=postgres://munfix:munfix@localhost:5432/munfix
REDIS_URL=redis://localhost:6379

# --- App ---
# Public URL of the app. Session cookies are marked Secure when this is https.
APP_URL=http://localhost:3000
# Where uploaded report photos are stored (use a persistent volume in production).
UPLOAD_DIR=./uploads

# --- Municipality (inlined at build time) ---
NEXT_PUBLIC_MUNICIPALITY_NAME=Iligan City
NEXT_PUBLIC_PROVINCE_NAME=Lanao del Norte
# Map center, longitude/latitude
NEXT_PUBLIC_MAP_CENTER_LNG=124.2452
NEXT_PUBLIC_MAP_CENTER_LAT=8.2280
# Reports must be pinned inside this box: minLng,minLat,maxLng,maxLat
NEXT_PUBLIC_MAP_BOUNDS=123.95,7.90,124.45,8.40
# Raster tile template. The public OSM server is fine for development only;
# use a tile provider or your own tile server in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Seeding (npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@munfix.local
SEED_ADMIN_PASSWORD=change-me-please
# Set to true to also insert a handful of demo reports
SEED_DEMO=false
