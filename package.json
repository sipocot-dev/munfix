{
  "name": "munfix",
  "version": "0.1.0",
  "private": true,
  "description": "MunFix — a civic reporting platform for Sipocot, Camarines Sur: citizens report infrastructure issues, see them on a map, and track resolution progress.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "services:up": "docker compose up -d db redis",
    "services:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "mail:test": "tsx --env-file-if-exists=.env scripts/mail-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.4.1",
    "maplibre-gl": "^5.0.0",
    "next": "^15.5.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
